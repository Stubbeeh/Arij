{
  "inputs": [
    {
      "id": "arij-user",
      "type": "promptString",
      "description": "Your collaborator name in Arij (used as ticket reporter)"
    }
  ],
  "servers": {
    "arij": {
      "type": "stdio",
      "command": "npm",
      "args": ["run", "--silent", "mcp"],
      "env": {
        "ARIJ_URL": "http://localhost:3000",
        "ARIJ_USER": "${input:arij-user}"
      }
    }
  }
}
